{
  "name": "cinetie-backend",
  "version": "1.0.0",
  "description": "Movies for everybody",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf ./src/dist && babel ./src/. --out-dir ./src/dist --copy-files",
    "start": "export NODE_ENV=staging && npm run migrate:staging && node  ./src/dist/index.js",
    "start-prod": "export NODE_ENV=production && npm run migrate && npm run build && node  ./src/dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec babel-node src/index.js",
    "migrate": "sequelize db:migrate --env production ",
    "migrate:dev": "sequelize db:migrate --env development",
    "migrate:payment": "sequelize db:migrate:undo:all && sequelize db:migrate && sequelize db:seed:all --env development",
    "migrate:undo:dev": "sequelize db:migrate:undo:all --env development",
    "migrate:staging": "sequelize db:migrate --env staging",
    "migrate:test": "cross-env NODE_ENV=test sequelize db:migrate:undo:all && cross-env NODE_ENV=test sequelize db:migrate && sequelize db:seed:all --debug",
    "generate-lcov": "nyc report --reporter=text > lcov.info",
    "lint": "eslint . --fix --ignore-path .gitignore",
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "test": "cross-env NODE_ENV=test npm run migrate:test && cross-env NODE_ENV=test nyc --reporter=html --reporter=text mocha --require @babel/register 'src/**/**test.js' --timeout 60000 --exit",
    "snyk-protect": "snyk protect",
    "prepare": "npm run snyk-protect"
  },
  "author": "Jonathan Shyaka",
  "dependencies": {
    "@babel/polyfill": "^7.8.3",
    "@hapi/joi": "^15.1.1",
    "Base64": "^1.1.0",
    "aws-sdk": "^2.607.0",
    "axios": "^0.19.1",
    "bcrypt": "^5.0.0",
    "body-parser": "^1.18.3",
    "chai": "^4.2.0",
    "chai-http": "^4.3.0",
    "cloudinary": "^1.17.0",
    "cors": "^2.8.4",
    "cross-env": "7.0.2",
    "dotenv": "^8.2.0",
    "ejs": "^3.0.1",
    "eslint": "^6.8.0",
    "eslint-cli": "^1.1.1",
    "eslint-config-airbnb-base": "^14.0.0",
    "express": "^4.16.3",
    "express-fileupload": "^1.1.6-alpha.6",
    "express-session": "^1.16.2",
    "flutterwave-node-v3": "^1.0.6",
    "image-size": "^0.8.3",
    "iplocation": "^6.1.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.15",
    "md5": "2.2.1",
    "moment": "^2.24.0",
    "multer": "^1.4.2",
    "mysql2": "2.1.0",
    "node-cron": "^2.0.3",
    "node-fetch": "^2.6.0",
    "node-forge": "^0.10.0",
    "nodemailer": "^6.4.2",
    "nodemailer-express-handlebars": "^3.1.0",
    "passport": "^0.4.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "paypal-rest-sdk": "^1.8.1",
    "pg": "^7.17.1",
    "pg-hstore": "^2.3.3",
    "request": "^2.88.0",
    "sequelize": "^5.22.3",
    "sinon": "^9.2.1",
    "snyk": "^1.316.1",
    "superagent": "^5.2.1",
    "uuid": "^3.4.0",
    "vimeo": "^2.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.3",
    "@babel/core": "^7.8.3",
    "@babel/node": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.12.1",
    "@babel/preset-env": "^7.8.3",
    "@babel/register": "^7.8.3",
    "babel-core": "^6.26.3",
    "babel-loader": "^8.0.6",
    "babel-polyfill": "^6.26.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "coveralls": "^3.1.0",
    "eslint-plugin-import": "^2.20.1",
    "fetch-mock": "^9.11.0",
    "mocha": "^7.0.1",
    "node-mocks-http": "^1.9.0",
    "nock": "^13.0.5",
    "nodemon": "^2.0.4",
    "nyc": "^15.0.0",
    "prettier-eslint": "^9.0.0",
    "prettier-eslint-cli": "^5.0.0",
    "proxyquire": "^2.1.3",
    "sequelize-cli": "^5.5.1",
    "sinon": "^9.2.1",
    "sinon-stub-promise": "^4.0.0"
  },
  "snyk": false
}
