{
  "name": "cinetie-backend",
  "version": "1.0.0",
  "description": "A Social platform for the creative at heart",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf ./src/dist && babel ./src/. --out-dir ./src/dist",

    "start": "npm run migrate && npm run build && node ./src/dist/index.js",

    "dev": "nodemon --exec babel-node src/index.js",
    "migrate": "sequelize db:migrate --env production",
    "migrate:dev": "sequelize db:migrate --env development"
  },
  "author": "Jonathan Shyaka",
  "dependencies": {
    "@hapi/joi": "^15.1.1",
    "bcrypt": "^3.0.6",
    "body-parser": "^1.18.3",
    "cors": "^2.8.5",
    "dotenv": "^6.2.0",
    "express": "^4.16.3",
    "express-session": "^1.16.2",
    "jsonwebtoken": "^8.5.1",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^7.12.1",
    "pg-hstore": "^2.3.3",
    "sequelize": "^5.18.2",
    "sequelize-cli": "^5.5.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.5.5",
    "@babel/core": "^7.5.5",
    "@babel/node": "^7.5.5",
    "@babel/preset-env": "^7.5.5",
    "@babel/register": "^7.5.5",
    "nodemon": "^1.19.2"
  }
}
