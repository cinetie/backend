{
  "name": "cinetie-backend",
  "version": "1.0.0",
  "description": "A Social platform for the creative at heart",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf ./src/dist && babel ./src/. --out-dir ./src/dist",
    "start": "npm run migrate && npm run build && node ./src/dist/index.js",
    "dev": "nodemon --exec babel-node src/index.js",
    "migrate": "sequelize db:migrate --env production ",
    "migrate:undo": "sequelize db:migrate:undo:all --env production ",
    "migrate:dev": "sequelize db:migrate --env development"
  },
  "author": "Jonathan Shyaka",
  "dependencies": {
    "@google-cloud/storage": "^4.1.3",
    "@hapi/joi": "^15.1.1",
    "axios": "^0.19.0",
    "bcrypt": "^3.0.6",
    "body-parser": "^1.18.3",
    "cloudinary": "^1.17.0",
    "cors": "^2.8.4",
    "dotenv": "^6.2.0",
    "eslint-cli": "^1.1.1",
    "eslint-config-airbnb-base": "^14.0.0",
    "express": "^4.16.3",
    "express-fileupload": "^1.1.6-alpha.6",
    "express-session": "^1.16.2",
    "image-size": "^0.8.3",
    "iplocation": "^6.1.0",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.24.0",
    "mysql2": "^1.7.0",
    "node-fetch": "^2.6.0",
    "nodemailer": "^6.3.0",
    "nodemailer-express-handlebars": "^3.1.0",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "passport": "^0.4.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "paypal-rest-sdk": "^1.8.1",
    "pg": "^7.12.1",
    "pg-hstore": "^2.3.3",
    "request": "^2.88.0",
    "sequelize": "^5.18.2",
    "sequelize-cli": "^5.5.1",
    "uuid": "^3.3.3",
    "vimeo": "^2.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.5.5",
    "@babel/core": "^7.5.5",
    "@babel/node": "^7.5.5",
    "@babel/polyfill": "^7.6.0",
    "@babel/preset-env": "^7.5.5",
    "@babel/register": "^7.5.5",
    "babel-core": "^6.26.3",
    "babel-loader": "^8.0.6",
    "babel-polyfill": "^6.26.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "nodemon": "^1.19.2",
    "prettier-eslint": "^9.0.0",
    "prettier-eslint-cli": "^5.0.0"
  }
}
