<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Change password</title>
    <style>
      .card {
        font-family: Arial, Helvetica, sans-serif;
        box-shadow: 0 6px 10px 0 rgba(0, 0, 0, 0.2);
        max-width: 500px;
        margin: auto;
        text-align: center;
        border-radius: 10px;
      }
      .btn {
        border: none;
        border-radius: 3px;
        color: white;
        padding: 10px 24px;
        cursor: pointer;
        background-color: #e50914;
      }
      .btn:hover {
        background: #c00811;
      }
      a {
        text-decoration: none;
        color: rgb(189, 0, 0);
      }
      a:hover {
        opacity: 0.7;
      }
      input {
        width: 35%;
        padding: 10px 10px;
        margin: 8px 0;
        border: 1px solid #ccc;
        border-radius: 5px;
        outline: none;
      }
    </style>
  </head>

  <body>
    <div class="card">
      <img
        src="https://images.wallpaperscraft.com/image/planet_comet_space_163352_3840x2160.jpg"
        alt="John"
        style="width:100%; border-top-left-radius: 10px; border-top-right-radius: 10px"
      />
      <h2>Hello from Cinetie</h2>
      <p style="color: grey; font-size: 18px;">
        Fill In The Form To Reset Your Password
      </p>
      <form action="<%=host%>/auth/reset-password" id= "submitForm" style="padding: 0 5px 10px 5px;" method="POST">
        <input type="password" placeholder="New Password" id="npass" required />
        <br />
        <input
          type="password"
          placeholder="Confirm New Password"
          id="cnpass"
          required
        />
        <br />
        <button class="btn" onclick="resetPassword()" type="submit">
          Submit
        </button>
      </form>
      <a href="#">Contact Us</a>
      <p style="color: rgb(148, 148, 148); padding: 5px;">
        &copy; Cinetie 2020 All Rights Reserved
      </p>
    </div>
    <script type="text/javascript">
      const rawUrl = window.location.href;
      const newUrl = new URL(rawUrl);
      const id = newUrl.searchParams.get("id");
      const token = newUrl.searchParams.get("token");
      function resetPassword() {
        event.preventDefault();
        let password = "";
        if (
          document.getElementById("npass").value ===
          document.getElementById("cnpass").value
        ) {
          password = document.getElementById("cnpass").value;
          alert('password has been reset');

        } else {
          alert("no password set");
        }
        const formData = new FormData();
        formData.append('password', password);
        const response = fetch(
          `<%=host%>/auth/reset-password?id=${id}&&token=${token}`,
          {
            method: "POST",
            body: formData,
          }
        );
        const responseJSON = response.json();
        window.location.replace('https://www.cinetie.com');
      }
    </script>
  </body>
</html>
